# Copy to .env (never committed) and adjust. Every value is optional: these are the defaults.

# Base64 key of at least 32 bytes that signs login tokens. Empty: a random key per start, so logins
# end whenever the backend restarts. Generate one with:  openssl rand -base64 32
JWT_SECRET=
JWT_TTL=1h

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5433

# Database (local / demo values)
POSTGRES_DB=pokedex
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=pokedex

POKEAPI_BASE_URL=https://pokeapi.co/api/v2

# Schema + demo users and Pokémon. Use classpath:db/migration to start without the demo data.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
